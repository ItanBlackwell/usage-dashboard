{
  "manifest_version": 3,
  "name": "Usage Dashboard · Billing",
  "version": "0.13.1",
  "description": "Read visible prepaid balances from OpenAI and OpenCode billing pages and send amounts to the local plugin.",
  "permissions": [
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://platform.openai.com/settings/organization/billing/*",
    "http://127.0.0.1:18746/*",
    "https://opencode.ai/workspace/*",
    "https://opencode.ai/console/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://platform.openai.com/settings/organization/billing/overview*",
        "https://opencode.ai/workspace/*/billing*",
        "https://opencode.ai/console/*/settings/billing*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/ItanBlackwell/usage-dashboard",
  "action": {
    "default_title": "Usage Dashboard Billing"
  }
}
